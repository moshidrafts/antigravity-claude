<# :
@echo off
title Antigravity Protocol Setup for Claude (1-Click Suite)
cls
echo =======================================================
echo    Installing Antigravity Protocol Suite for Claude...
echo =======================================================
powershell -NoProfile -ExecutionPolicy Bypass -Command "Invoke-Expression (Get-Content -Raw '%~f0')"
echo.
pause
exit /b %ERRORLEVEL%
: #>

$ErrorActionPreference = "Stop"
$userProfile = [System.Environment]::GetFolderPath('UserProfile')
$claudeDir = Join-Path $userProfile ".claude"
$skillsDir = Join-Path $claudeDir "skills"

Write-Host "`n[1/4] Setting up Claude directories..." -ForegroundColor Cyan
New-Item -ItemType Directory -Force -Path $claudeDir | Out-Null
New-Item -ItemType Directory -Force -Path $skillsDir | Out-Null
Write-Host "  -> Done." -ForegroundColor Green

Write-Host "`n[2/4] Deploying global CLAUDE.md..." -ForegroundColor Cyan
$claudeMdBytes = [System.Convert]::FromBase64String("")
$claudeMdContent = [System.Text.Encoding]::UTF8.GetString($claudeMdBytes)
$claudeMdPath = Join-Path $claudeDir "CLAUDE.md"
[System.IO.File]::WriteAllText($claudeMdPath, $claudeMdContent, [System.Text.Encoding]::UTF8)
Write-Host "  -> Deployed: $claudeMdPath" -ForegroundColor Green

Write-Host "`n[3/4] Installing all Antigravity & Community Skills..." -ForegroundColor Cyan
$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
$localSkills = Join-Path $scriptDir "skills"

if (Test-Path $localSkills) {
    Get-ChildItem -Path $localSkills -Directory | ForEach-Object {
        $target = Join-Path $skillsDir $_.Name
        Copy-Item -Path $_.FullName -Destination $target -Recurse -Force
        Write-Host "  -> Installed skill: $($_.Name)" -ForegroundColor Green
    }
} else {
    Write-Host "  -> Local skills directory copied." -ForegroundColor Yellow
}

Write-Host "`n[4/4] Copying Custom Instructions to Windows Clipboard..." -ForegroundColor Cyan
$instructionsBytes = [System.Convert]::FromBase64String("")
$customInstructions = [System.Text.Encoding]::UTF8.GetString($instructionsBytes)
Set-Clipboard -Value $customInstructions
Write-Host "  -> Custom Instructions COPIED to your Windows Clipboard!" -ForegroundColor Green

Write-Host "`n=======================================================" -ForegroundColor Yellow
Write-Host " [SUCCESS] Antigravity Suite is completely installed!  " -ForegroundColor Yellow
Write-Host "=======================================================" -ForegroundColor Yellow
Write-Host "1. Claude Code CLI files & skills deployed to: $claudeDir"
Write-Host "2. Custom Instructions for Claude Desktop are in your Clipboard right now."
Write-Host "   -> Open Claude Desktop -> Settings -> Custom Instructions and press Ctrl+V!`n"

try {
    Add-Type -AssemblyName PresentationFramework -ErrorAction SilentlyContinue
    [System.Windows.MessageBox]::Show("Antigravity Protocol for Claude has been successfully installed!`n`n1. Global CLAUDE.md and Skills deployed to .claude directory.`n2. Custom Instructions have been COPIED TO YOUR CLIPBOARD!`n`nJust press Ctrl+V in Claude Desktop Settings -> Custom Instructions.", "Antigravity Setup Complete", "OK", "Information") | Out-Null
} catch {
    # Ignore if GUI message box is unavailable
}
